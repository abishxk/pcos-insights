{
  "builds": [
    { "src": "static/**", "use": "@vercel/static" },
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "models/**",
          "pcos/**",
          "PCOS_data_without_infertility.xlsx"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}
